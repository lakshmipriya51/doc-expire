{
  "name": "doc-expire",
  "version": "1.0.0",
  "private": true,
  "description": "DocExpire - Android app for tracking document expiry dates and reminders",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm start --prefix server",
    "serve": "npm run build && npm start",
    "serve:local": "node scripts/serve-local.js",
    "service:install": "node scripts/install-local-service.js",
    "service:uninstall": "node scripts/uninstall-local-service.js",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "smoke": "node server/scripts/smoke-test.js",
    "build": "npm run build --prefix client",
    "icons": "node scripts/generate-icons.js",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:build:android": "npm run mobile:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  }
}
