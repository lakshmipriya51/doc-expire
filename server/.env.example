# ---- Server ----
PORT=5000
NODE_ENV=development

# Port used by "npm run serve:local" and the background service, so the app
# always has the same permanent address. Ignored by "npm run dev".
LOCAL_PORT=5050

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/docexpire
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv:<user>:<password>@<cluster>.mongodb.net/docexpire?retryWrites=true&w=majority

# ---- Authentication ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of allowed browser origins.
# On a deployment this must be the deployed web origin, e.g.
#   CLIENT_URL=https://your-docexpire-service.onrender.com
CLIENT_URL=http://localhost:5173

# Origins of the packaged Capacitor app. These are defaults, so you normally do
# not need to set this: the native app runs on the device and never sends the
# deployed web origin, so it is allowed separately from CLIENT_URL. Without
# them, registration from the Android/iOS app fails with a CORS error even
# though the API is healthy. Override only if you changed the Capacitor scheme
# in capacitor.config.json.
# NATIVE_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Expiry rules ----
# Documents expiring within this many days are flagged "Expiring Soon".
EXPIRING_SOON_DAYS=30

# ---- Rate limiting ----
# Set to true only for local development or automated tests, otherwise the
# auth endpoints will throttle you after a handful of requests.
RATE_LIMIT_DISABLED=false

# ---- Optional email reminders ----
# When EMAIL_ENABLED is false the app only uses in-app notifications.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=DocExpire <no-reply@example.com>

# ---- Demo seed account ----
SEED_USER_EMAIL=demo@docexpire.dev
SEED_USER_PASSWORD=Demo@12345
SEED_USER_NAME=Demo User
