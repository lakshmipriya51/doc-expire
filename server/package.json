{
  "name": "docexpire-server",
  "version": "1.0.0",
  "private": true,
  "description": "DocExpire REST API - document expiry reminder system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:memory": "node scripts/start-with-memory-db.js",
    "seed": "node utils/seed.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
