# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files (keep the .example templates)
.env
.env.*
!.env.example

# Runtime uploads
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-error.log*
.logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test artefacts
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Signing material. Never commit these. Keep the keystore and the Gradle
# credentials out of the repository (see README for where they belong).
# ---------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
android/keystore.properties
android/signing.properties

# ---------------------------------------------------------------------------
# Native mobile builds (Capacitor)
#
# The generated tool directories are ignored, but android/app/src/main/assets/
# public and ios/App/App/public ARE committed on purpose: Gradle and Xcode both
# read the web build straight out of those folders, so if they were ignored a
# fresh clone would still build an APK and an app bundle that contain no web
# assets at all. Committing them keeps the shipped APKs reproducible from a
# clean checkout. Run "npm run mobile:sync" to refresh them after a web build.
# ---------------------------------------------------------------------------
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/captures/
android/local.properties
android/app/src/main/res/xml/config.xml

ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
ios/DerivedData/
ios/build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.moved-aside