# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files (keep the .example templates)
.env
.env.*
!.env.example

# Runtime uploads
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-error.log*
.logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test artefacts
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Signing material. Never commit these. Keep the keystore and the Gradle
# credentials out of the repository (see README for where they belong).
# ---------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
android/keystore.properties
android/signing.properties

# ---------------------------------------------------------------------------
# Native mobile builds (Capacitor)
#
# The generated tool directory is ignored, but android/app/src/main/assets/public
# IS committed on purpose: Gradle reads the web build straight out of that
# folder, so if it were ignored a fresh clone would still build an APK and an app
# bundle that contain no web assets at all. Committing it keeps the shipped APKs
# reproducible from a clean checkout. Run "npm run mobile:sync" to refresh it
# after a web build.
# ---------------------------------------------------------------------------
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/captures/
android/local.properties
android/app/src/main/res/xml/config.xml

# iOS support was removed. These patterns only stop a stray local Capacitor iOS
# checkout (for example from "npx cap add ios") being committed by accident.
ios/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside