# ---- DocExpire (root) ----
# The root package only orchestrates the two workspaces; the API and client
# each read their own .env file.
#
#   server/.env  -> PORT, MONGODB_URI, JWT_SECRET, ...
#   client/.env  -> VITE_API_URL
#
# Copy the templates to get started:
#   cp server/.env.example server/.env
#   cp client/.env.example client/.env

# ---- Runtime settings ----
# Concurrent dev ports. Keep these in sync with server/.env and client/.env.
SERVER_PORT=5000
CLIENT_PORT=5173